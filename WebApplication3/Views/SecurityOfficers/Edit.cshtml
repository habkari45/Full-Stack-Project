@using WebApplication3.Application.DTOs
@model SecurityOfficerUpdateDto

<div class="container">

    <h1>Edit Security Officer</h1>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">

        <input asp-for="Id" type="hidden" />
        <input asp-for="ImageUrl" type="hidden" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="EmployeeNumber" class="form-label"></label>
            <input asp-for="EmployeeNumber" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Shift" class="form-label"></label>
            <input asp-for="Shift" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Current Image</label>
            <br />

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl"
                     alt="Officer Image"
                     width="100"
                     height="100"
                     style="object-fit: cover; border-radius: 8px;" />
            }
            else
            {
                <span>No Image</span>
            }
        </div>

        <div class="mb-3">
            <label class="form-label">Change Officer Image</label>
            <input type="file"
                   name="imageFile"
                   class="form-control"
                   accept="image/*" />
        </div>

        <button type="submit" class="btn btn-warning">
            Update
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Back
        </a>

    </form>

</div>