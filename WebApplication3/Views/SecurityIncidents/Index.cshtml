@using WebApplication3.Application.DTOs
@model IEnumerable<SecurityIncidentDto>

<div class="container">

    <h1>Security Incidents</h1>

    <div class="text-end mb-3">
        <a asp-action="Create" class="btn btn-primary">
            New Incident
        </a>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Image</th>
                <th>Title</th>
                <th>Incident Type</th>
                <th>Location</th>
                <th>Incident Date</th>
                <th>Status</th>
                <th>Description</th>
                <th>Security Officer</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var incident in Model)
            {
                <tr>
                    <td>@incident.Id</td>

                    <td>
                        @if (!string.IsNullOrEmpty(incident.ImageUrl))
                        {
                            <img src="@incident.ImageUrl"
                                 alt="Incident Image"
                                 width="60"
                                 height="60"
                                 style="object-fit: cover; border-radius: 8px;" />
                        }
                        else
                        {
                            <span>No Image</span>
                        }
                    </td>

                    <td>@incident.Title</td>
                    <td>@incident.IncidentType</td>
                    <td>@incident.Location</td>
                    <td>@incident.IncidentDate</td>
                    <td>@incident.Status</td>
                    <td>@incident.Description</td>
                    <td>@incident.SecurityOfficerName</td>

                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@incident.Id"
                           class="btn btn-warning">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@incident.Id"
                           class="btn btn-danger">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>