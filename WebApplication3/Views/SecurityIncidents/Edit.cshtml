@using WebApplication3.Application.DTOs
@model SecurityIncidentUpdateDto

<div class="container">

    <h1>Edit Security Incident</h1>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">

        <input asp-for="Id" type="hidden" />

        <div class="mb-3">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="IncidentType" class="form-label"></label>
            <input asp-for="IncidentType" class="form-control" />
            <span asp-validation-for="IncidentType" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Location" class="form-label"></label>
            <input asp-for="Location" class="form-control" />
            <span asp-validation-for="Location" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="IncidentDate" class="form-label"></label>
            <input asp-for="IncidentDate"
                   type="datetime-local"
                   class="form-control" />
            <span asp-validation-for="IncidentDate" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label"></label>
            <input asp-for="Status" class="form-control" />
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <input asp-for="Description" class="form-control" />
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="SecurityOfficerId" class="form-label">
                Security Officer
            </label>

            <select asp-for="SecurityOfficerId"
                    class="form-control"
                    asp-items="ViewBag.SecurityOfficers">

                <option value="">-- Select Security Officer --</option>

            </select>

            <span asp-validation-for="SecurityOfficerId"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Current Incident Image</label>
            <br />

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl"
                     alt="Incident Image"
                     width="100"
                     height="100"
                     style="object-fit: cover; border-radius: 8px;" />
            }
            else
            {
                <span>No Image</span>
            }
        </div>

        <div class="mb-3">
            <label class="form-label">Change Incident Image</label>

            <input type="file"
                   name="imageFile"
                   class="form-control"
                   accept=".jpg,.jpeg,.png" />

            <span class="text-danger">
                @Html.ValidationMessage("imageFile")
            </span>
        </div>

        <button type="submit" class="btn btn-warning">
            Update
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Back
        </a>

    </form>

</div>