@model IEnumerable<User>

<div class="container">

    <h1>Users</h1>

    <div class="text-end mb-3">
        <a asp-action="Create" class="btn btn-primary">
            New User
        </a>
    </div>

    <table class="table table-striped">

        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>User Name</th>
                <th>Email</th>
                <th>Is Locked</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.Name</td>
                    <td>@user.UserName</td>
                    <td>@user.Email</td>
                    <td>@user.IsLocked</td>

                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@user.Id"
                           class="btn btn-warning">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@user.Id"
                           class="btn btn-danger">
                            Delete
                        </a>
                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>
