
    @model IEnumerable<WebApplication2.Models.Customer>

<h2>Customers</h2>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Full Name</th>
            <th>Email</th>
            <th>City</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var customer in Model)
        {
            <tr>
                <td>@customer.Id</td>
                <td>@customer.FullName</td>
                <td>@customer.Email</td>
                <td>@customer.City</td>
            </tr>
        }
    </tbody>
</table>


}
