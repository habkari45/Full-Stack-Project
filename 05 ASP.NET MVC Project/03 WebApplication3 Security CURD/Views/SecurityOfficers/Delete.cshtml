@model SecurityOfficer

<div class="container">

    <h1>Delete Security Officer</h1>

    <p>Are you sure you want to delete this security officer?</p>

    <div class="mb-3">
        <strong>Name:</strong> @Model.Name
    </div>

    <div class="mb-3">
        <strong>Employee Number:</strong> @Model.EmployeeNumber
    </div>

    <div class="mb-3">
        <strong>Shift:</strong> @Model.Shift
    </div>

    <div class="mb-3">
        <strong>Phone:</strong> @Model.Phone
    </div>

    <form asp-action="Delete" method="post">

        <input asp-for="Id" type="hidden" />

        <button type="submit" class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Back
        </a>

    </form>

</div>
