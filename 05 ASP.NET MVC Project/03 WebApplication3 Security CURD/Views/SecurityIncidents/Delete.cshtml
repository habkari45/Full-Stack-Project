@model SecurityIncident

<div class="container">

    <h1>Delete Security Incident</h1>

    <p>Are you sure you want to delete this security incident?</p>

    <div class="mb-3">
        <strong>Title:</strong> @Model.Title
    </div>

    <div class="mb-3">
        <strong>Incident Type:</strong> @Model.IncidentType
    </div>

    <div class="mb-3">
        <strong>Location:</strong> @Model.Location
    </div>

    <div class="mb-3">
        <strong>Incident Date:</strong> @Model.IncidentDate
    </div>

    <div class="mb-3">
        <strong>Status:</strong> @Model.Status
    </div>

    <div class="mb-3">
        <strong>Description:</strong> @Model.Description
    </div>

    <form asp-action="Delete" method="post">

        <input asp-for="Id" type="hidden" />

        <button type="submit" class="btn btn-danger">Delete</button>

        <a asp-action="Index" class="btn btn-secondary">Back</a>

    </form>

</div>
